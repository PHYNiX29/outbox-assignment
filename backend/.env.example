# ---------- Server ----------
PORT=4000
# Where the React app runs (used for CORS + post-login redirects)
FRONTEND_URL=http://localhost:5173
# Public URL of this backend (used to build OAuth redirect URIs)
BACKEND_URL=http://localhost:4000
JWT_SECRET=change-me-to-a-long-random-string
# Run the BullMQ worker inside the API process (set false and run `npm run dev:worker` to scale separately)
RUN_WORKER=true

# ---------- Infra ----------
DATABASE_URL=postgresql://outbox:outbox@localhost:5432/outbox?schema=public
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# ---------- Worker / throughput ----------
# How many jobs a single worker processes in parallel
WORKER_CONCURRENCY=5
# Minimum gap between two sends from the SAME sender (Redis-coordinated across all workers)
MIN_DELAY_BETWEEN_SENDS_MS=2000
# Hourly cap per sender mailbox (Redis counters, shared across all workers/instances)
MAX_EMAILS_PER_HOUR_PER_SENDER=200
# Retry attempts for SMTP failures before marking an email as failed
EMAIL_MAX_ATTEMPTS=3

# ---------- Ethereal senders ----------
# Number of Ethereal sender accounts to auto-create on first boot (if none exist in DB)
ETHEREAL_SENDER_COUNT=3
# Optional: use existing Ethereal accounts instead, comma separated "user:pass" pairs
ETHEREAL_ACCOUNTS=

# ---------- Google OAuth ----------
# Authorized redirect URI in Google Cloud Console: ${BACKEND_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Slack OAuth ----------
# Redirect URL in the Slack app config must be HTTPS: e.g. https://<tunnel>/api/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=

# auto = simulate SMTP on Railway (blocked there), real SMTP elsewhere | smtp | simulate
EMAIL_DELIVERY=auto
