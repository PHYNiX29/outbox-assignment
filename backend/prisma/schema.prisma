generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String           @id @default(uuid())
  email        String           @unique
  name         String
  avatarUrl    String?
  googleId     String?          @unique
  passwordHash String?
  createdAt    DateTime         @default(now())
  slack        SlackConnection?
  campaigns    Campaign[]
  emails       Email[]
}

/// One Slack workspace connection per user, created via the Slack OAuth v2 flow.
model SlackConnection {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId      String
  teamName    String
  channelName String?
  webhookUrl  String
  accessToken String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// SMTP sender mailbox (Ethereal test accounts).
model Sender {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  smtpHost  String
  smtpPort  Int
  smtpUser  String
  smtpPass  String
  createdAt DateTime   @default(now())
  campaigns Campaign[]
  emails    Email[]
}

/// A single "Compose -> Schedule" action. Fans out into one Email row per recipient.
model Campaign {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderId       String
  sender         Sender   @relation(fields: [senderId], references: [id])
  subject        String
  body           String
  startAt        DateTime
  delayMs        Int
  hourlyLimit    Int?
  idempotencyKey String?
  createdAt      DateTime @default(now())
  emails         Email[]

  @@unique([userId, idempotencyKey])
}

enum EmailStatus {
  SCHEDULED
  SENDING
  SENT
  FAILED
}

model Email {
  id           String      @id
  campaignId   String
  campaign     Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderId     String
  sender       Sender      @relation(fields: [senderId], references: [id])
  toEmail      String
  toName       String?
  subject      String
  body         String
  seq          Int
  status       EmailStatus @default(SCHEDULED)
  scheduledAt  DateTime
  sentAt       DateTime?
  failedReason String?
  messageId    String?
  previewUrl   String?
  attempts     Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([campaignId, toEmail])
  @@index([userId, status, scheduledAt])
  @@index([status, scheduledAt])
}
